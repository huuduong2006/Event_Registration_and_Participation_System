# Sao chép thành .env rồi điền:   cp .env.example .env
# KHÔNG commit file .env lên Git.

# --- Bắt buộc (để trống thì ứng dụng KHÔNG khởi động được) ---
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=2ECm9w0PNG2fBlnM-DCc_trX5vIp4tM4N_cgntN9_TLxCrfvVMGeW-YVa1Bq87O2
# Địa chỉ công khai của web (dùng trong link ở email vé), VD: https://sukien.example.com  (thử cục bộ: http://localhost:8000)
BASE_URL=http://localhost:8000

# --- Administrator đầu tiên (Data Seeding): tự tạo khi khởi động nếu email chưa tồn tại ---
# Mật khẩu >= 10 ký tự. Sau khi đăng nhập được, nên đổi mật khẩu rồi XOÁ ADMIN_PASSWORD khỏi .env.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Quản trị viên

# --- Chỉ cần khi bật HTTPS (docker compose --profile https ...) ---
DOMAIN=sukien.example.com

# --- Email: bỏ trống SMTP_HOST thì hệ thống KHÔNG gửi thật, chỉ ghi vào outbox ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Event <no-reply@example.com>"

# --- Tuỳ chọn ---
# APP_PORT=8000
# TZ_OFFSET_HOURS=7        # múi giờ sự kiện (Việt Nam = 7)
# TOKEN_TTL_HOURS=12
# LOGIN_RATE_MAX=30
# REG_RATE_MAX=20
